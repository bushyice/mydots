# Font Configuration
font-size = 12

# Window Configuration
window-decoration = false
window-padding-x = 16
window-padding-y = 12
background-opacity = 0.8
# background-blur-radius = 32

# Cursor Configuration
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 5025

# Terminal features
mouse-hide-while-typing = false
copy-on-select = true
confirm-close-surface = false

# Disable annoying copied to clipboard
app-notifications = no-clipboard-copy,no-config-reload

# Key bindings for common actions
#keybind = ctrl+c=copy_to_clipboard
#keybind = ctrl+v=paste_from_clipboard
# keybind = ctrl+shift+n=new_window
# keybind = ctrl+t=new_tab
keybind = ctrl+plus=increase_font_size:1
keybind = ctrl+minus=decrease_font_size:1
keybind = ctrl+zero=reset_font_size
# keybind = alt+v=new_split:right
# keybind = alt+h=new_split:down
# keybind = alt+q=close_surface
# keybind = alt+tab=goto_split:previous
# keybind = alt+r>left=resize_split:left,50
# keybind = alt+r>right=resize_split:right,50
# keybind = alt+r>up=resize_split:up,50
# keybind = alt+r>down=resize_split:down,50
# keybind = alt+left=goto_split:left
# keybind = alt+right=goto_split:right
# keybind = alt+up=goto_split:up
# keybind = alt+down=goto_split:down
# keybind = alt+w=toggle_split_zoom
keybind = global:alt+backquote=toggle_quick_terminal

# Material 3 UI elements
unfocused-split-opacity = 0.7
unfocused-split-fill = #181825

# Tab configuration
gtk-titlebar = false

# Shell integration
shell-integration = detect
shell-integration-features = cursor,sudo,title,no-cursor
keybind = shift+enter=text:\n

# Rando stuff
gtk-single-instance = true

# Dank color generation
theme = catppuccin

