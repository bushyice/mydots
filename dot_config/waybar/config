[
  {
    "backlight": {
      "device": "intel_backlight",
      "format": "{icon}  {percent}%",
      "format-icons": [
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        "",
        ""
      ],
      "min-length": 6,
      "on-scroll-down": "brightnessctl set 1%-",
      "on-scroll-up": "brightnessctl set 1%+"
    },
    "battery": {
      "format": "{icon} {capacity}%",
      "format-alt": "{time} {icon}",
      "format-charging": " {capacity}%",
      "format-icons": [
        "󰂎",
        "󰁺",
        "󰁻",
        "󰁼",
        "󰁽",
        "󰁾",
        "󰁿",
        "󰂀",
        "󰂁",
        "󰂂",
        "󰁹"
      ],
      "format-plugged": " {capacity}%",
      "states": {
        "critical": 20,
        "good": 95,
        "warning": 30
      }
    },
    "bluetooth": {
      "format": "",
      "format-connected": " {num_connections}",
      "format-disabled": "",
      "tooltip-format": " {device_alias}",
      "tooltip-format-connected": "{device_enumerate}",
      "tooltip-format-enumerate-connected": " {device_alias}"
    },
    "clock": {
      "actions": {
        "on-click-backward": "tz_down",
        "on-click-forward": "tz_up",
        "on-click-right": "mode",
        "on-scroll-down": "shift_down",
        "on-scroll-up": "shift_up"
      },
      "calendar": {
        "format": {
          "months": "<span color='#ffead3'><b>{}</b></span>",
          "today": "<span color='#ff6699'><b>{}</b></span>",
          "weekdays": "<span color='#ffcc66'><b>{}</b></span>"
        },
        "mode": "month",
        "mode-mon-col": 3,
        "on-click-right": "mode",
        "on-scroll": 1
      },
      "format": "{:%I:%M %p}",
      "format-alt": "{:%R 󰃭 %d·%m·%y}",
      "tooltip-format": "<tt>{calendar}</tt>"
    },
    "cpu": {
      "format": "󰍛 {usage}%",
      "format-alt": "{icon0}{icon1}{icon2}{icon3}",
      "format-icons": [
        "▁",
        "▂",
        "▃",
        "▄",
        "▅",
        "▆",
        "▇",
        "█"
      ],
      "interval": 10
    },
    "custom/gpuinfo": {
      "exec": "~/.config/scripts/gpuinfo.sh",
      "format": " {}",
      "interval": 5,
      "max-length": 1000,
      "return-type": "json",
      "tooltip": true
    },
    "custom/l_end": {
      "format": " ",
      "interval": "once",
      "tooltip": false
    },
    "custom/padd": {
      "format": "  ",
      "interval": "once",
      "tooltip": false
    },
    "custom/power": {
      "exec": "echo ; echo  logout",
      "format": "{}",
      "interval": 86400,
      "on-click": "~/.config/scripts/logoutlaunch.sh 2",
      "tooltip": true
    },
    "custom/r_end": {
      "format": " ",
      "interval": "once",
      "tooltip": false
    },
    "custom/rl_end": {
      "format": " ",
      "interval": "once",
      "tooltip": false
    },
    "custom/rr_end": {
      "format": " ",
      "interval": "once",
      "tooltip": false
    },
    "custom/sl_end": {
      "format": " ",
      "interval": "once",
      "tooltip": false
    },
    "custom/sr_end": {
      "format": " ",
      "interval": "once",
      "tooltip": false
    },
    "custom/swaync": {
      "format": "{}",
      "on-click": "swaync-client -t",
      "tooltip": false
    },
    "custom/system": {
      "exec": "echo ; echo 󰘚 system monitor",
      "format": "󰘚{}",
      "interval": 86400,
      "on-click": "sleep 0.1 && missioncenter",
      "tooltip": true
    },
    "exclusive": true,
    "gtk-layer-shell": true,
    "height": 31,
    "hyprland/workspaces": {
      "active-only": false,
      "all-outputs": true,
      "disable-scroll": true,
      "format": "{icon}",
      "format-icons": {
        "1": "",
        "10": "",
        "2": "",
        "3": "",
        "4": "",
        "5": "",
        "6": "",
        "7": "",
        "8": "",
        "9": "󰌳",
        "default": ""
      },
      "on-click": "activate",
      "persistent-workspaces": {}
    },
    "idle_inhibitor": {
      "format": "{icon}",
      "format-icons": {
        "activated": "󰥔",
        "deactivated": "󰥔"
      }
    },
    "layer": "top",
    "memory": {
      "format": "󰾆 {percentage}%",
      "format-alt": "󰾅 {used}GB",
      "interval": 30,
      "max-length": 20,
      "tooltip": true,
      "tooltip-format": " {used:0.1f}GB/{total:0.1f}GB"
    },
    "mod": "dock",
    "modules-center": [
      "custom/padd",
      "custom/l_end",
      "wlr/taskbar",
      "custom/r_end",
      "custom/padd"
    ],
    "modules-left": [
      "custom/padd",
      "custom/l_end",
      "cpu",
      "memory",
      "custom/gpuinfo",
      "custom/r_end",
      "custom/l_end",
      "idle_inhibitor",
      "clock",
      "custom/r_end",
      "custom/l_end",
      "niri/workspaces",
      "sway/workspaces",
      "custom/r_end",
      "custom/padd"
    ],
    "modules-right": [
      "custom/padd",
      "custom/l_end",
      "backlight",
      "network",
      "bluetooth",
      "pulseaudio",
      "custom/r_end",
      "custom/l_end",
      "tray",
      "battery",
      "custom/r_end",
      "custom/l_end",
      "custom/swaync",
      "custom/system",
      "custom/power",
      "custom/r_end",
      "custom/padd"
    ],
    "network": {
      "format-alt": "󰤨  {signalStrength}%",
      "format-disconnected": " Disconnected",
      "format-ethernet": "󱘖 Wired",
      "format-linked": "󱘖  {ifname} (No IP)",
      "format-wifi": "󰤨  {essid}",
      "interval": 5,
      "tooltip-format": "󱘖  {ipaddr}   {bandwidthUpBytes}   {bandwidthDownBytes}"
    },
    "niri/workspaces": {
      "active-only": false,
      "all-outputs": true,
      "disable-scroll": true,
      "format": "{icon}",
      "format-icons": {
        "1": "",
        "2": "",
        "default": " "
      },
      "on-click": "activate",
      "persistent-workspaces": {}
    },
    "passthrough": false,
    "position": "bottom",
    "pulseaudio": {
      "format": "{icon} {volume}",
      "format-icons": {
        "car": "",
        "default": [
          "",
          " ",
          " "
        ],
        "hands-free": "",
        "headphone": "",
        "headset": "",
        "phone": "",
        "portable": ""
      },
      "format-muted": "󰝟 ",
      "on-click": "pavucontrol -t 3",
      "on-click-middle": "~/.config/scripts/volumecontrol.sh -o m",
      "on-scroll-down": "~/.config/scripts/volumecontrol.sh -o d",
      "on-scroll-up": "~/.config/scripts/volumecontrol.sh -o i",
      "scroll-step": 5,
      "tooltip-format": "{icon} {desc} // {volume}%"
    },
    "sway/workspaces": {
      "active-only": false,
      "all-outputs": true,
      "disable-scroll": true,
      "format": "{icon}",
      "format-icons": {
        "1": "",
        "10": "",
        "2": "",
        "3": "",
        "4": "",
        "5": "",
        "6": "",
        "7": "",
        "8": "",
        "9": "󰌳",
        "default": ""
      },
      "on-click": "activate",
      "persistent-workspaces": {}
    },
    "tray": {
      "icon-size": 18,
      "spacing": 5
    },
    "wlr/taskbar": {
      "format": "{icon}",
      "icon-size": 18,
      "icon-theme": "Papirus-Dark",
      "ignore-list": [
        "Alacritty",
        "foot",
        "Ghostty",
        "dev.warp.Warp",
        "kitty",
        "Foot",
        "ghostty",
        "com.mitchellh.ghostty"
      ],
      "on-click": "activate",
      "on-click-middle": "close",
      "spacing": 0,
      "tooltip-format": "{title}"
    },
    "wlr/workspaces": {
      "active-only": false,
      "all-outputs": true,
      "disable-scroll": true,
      "format": "{icon}",
      "format-icons": {
        "1": "",
        "10": "",
        "2": "",
        "3": "",
        "4": "",
        "5": "",
        "6": "",
        "7": "",
        "8": "",
        "9": "󰌳",
        "default": ""
      },
      "on-click": "activate",
      "persistent-workspaces": {}
    }
  }
]
